# PsycheEdge 2025 Environment Variables

# Telegram Bot (optional)
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Oura Ring API (optional)
# Get from: https://cloud.ouraring.com/personal-access-tokens
OURA_API_TOKEN=your_oura_api_token_here

# Swarm Configuration
SWARM_INITIAL_POPULATION=40
SWARM_MAX_POPULATION=200
SWARM_CYCLE_INTERVAL=1.0

# Data Directory (optional, defaults to psyche_edge/data)
DATA_DIR=psyche_edge/data
